<?xml version="1.0" encoding="utf-8"?>
<!-- 도착 모드 6화면. Portrait 1:1(841×1210) 기준, 2:0에선 900dp 폭으로 가운데 정렬. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="900dp">

        <!-- 01 대기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도착 모드"
                android:textColor="@color/text_sub"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/waitDest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="더현대 서울"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waitRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="도착까지 18분 · 12.4km"
                android:textColor="@color/text_sub"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:text="도착할 즈음, 주차장은 이럴 것 같아요"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/waitLot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="더현대 서울 주차장"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_chip_orange"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="혼잡 예상"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="도착 시간대 만차율 95%"
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />

                <com.arrival.mode.BarChartView
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/altBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingVertical="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="근처에 더 여유 있는 주차장 2곳"
                    android:textColor="@color/blue_pale"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="도착 10분 전에 말로 알려드릴게요"
                    android:textColor="@color/text_on_dark_sub"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 02 도착 10분 전 주차 브리핑 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="더 편한 주차장을 찾아봤어요"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="도착 전에 정해두면 바로 길을 바꿔드릴게요"
                android:textColor="@color/text_sub"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/altCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/briefAltName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="여의도 공영주차장"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_chip_blue"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="추천"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/briefAltDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="300m · 실내 · 더 넓어요"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/briefAltSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="여유 · 2시간 무료"
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/briefMainName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="더현대 서울 주차장"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="목적지"
                        android:textColor="@color/chip_gray_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/briefMainDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="입구: 건물 뒷편 골목"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/briefMainSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="혼잡 · 10분당 1,000원"
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/listenBrief"
                layout="@layout/part_listening"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 03 경유지 추가 -->
        <LinearLayout
            android:id="@+id/waypointScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_circle_dark"
                android:contentDescription="@null"
                android:padding="40dp"
                android:src="@drawable/ic_check" />

            <TextView
                android:id="@+id/waypointTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="여의도 공영주차장을\n경유지로 넣었어요"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waypointSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="현재 위치로부터 300m"
                android:textColor="@color/text_sub"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/undoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:background="@drawable/bg_button_pill"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="56dp"
                android:paddingVertical="22dp"
                android:text="되돌리기"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- 04-1 P단 주차 위치 저장 · 층·구역 묻기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="40dp">

            <include
                android:id="@+id/parkedAsk"
                layout="@layout/part_parked_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_circle_blue"
                    android:contentDescription="@null"
                    android:padding="36dp"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp"
                    android:text="몇 층 어디에 세우셨어요?"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="말해주시면 위치에 같이 적어둘게요"
                    android:textColor="@color/text_sub"
                    android:textSize="22sp" />
            </LinearLayout>

            <include
                android:id="@+id/listenAsk"
                layout="@layout/part_listening"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 04-2 층·구역 저장 완료 -->
        <LinearLayout
            android:id="@+id/savedScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="40dp">

            <include
                android:id="@+id/parkedSaved"
                layout="@layout/part_parked_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@null"
                    android:padding="34dp"
                    android:src="@drawable/ic_check" />

                <TextView
                    android:id="@+id/spotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp"
                    android:text="지하 2층 C구역"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spotSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="위치와 함께 폰으로 보냈어요."
                    android:textColor="@color/text_sub"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/retryRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_mic_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="틀렸다면 다시 말해주세요."
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 05 다음 시동 주차 요약 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="무료 주차 시간"
                    android:textColor="@color/text_on_dark_sub"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/freeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="20분 남았어요"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/freeProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="24dp"
                    android:max="120"
                    android:progress="100"
                    android:progressDrawable="@drawable/progress_free" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1시간 40분 경과"
                        android:textColor="@color/text_on_dark_sub"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/freeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2시간 무료"
                        android:textColor="@color/blue_pale"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="어디로 갈까요?"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/homeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_selected"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="집"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="32분 · 24.1km"
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/workCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="회사"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="18분 · 9.8km"
                    android:textColor="@color/text_sub"
                    android:textSize="20sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_navy"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingVertical="30dp"
                android:text="안내 시작"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>

    <!-- 권한·서비스 상태 안내 띠. 평소엔 숨김, 누르면 권한 창이나 앱 설정으로 -->
    <TextView
        android:id="@+id/notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_orange"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:textColor="@color/orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="820dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
