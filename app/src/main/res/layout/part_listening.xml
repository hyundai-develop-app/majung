<?xml version="1.0" encoding="utf-8"?>
<!-- 음성 카드. 안내하는 중 / 내비 안내 대기 / 듣고 있어요 / 다시 말해 주세요 상태를 MainActivity.renderVoice가 바꾼다. 탭은 음성 대신 선택. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="32dp"
    android:paddingVertical="26dp">

    <ImageView
        android:id="@+id/voiceIcon"
        android:layout_width="64dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_wave" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/voiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="듣고 있어요"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="말로 답하거나 카드를 눌러주세요"
            android:textColor="@color/text_on_dark_sub"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
